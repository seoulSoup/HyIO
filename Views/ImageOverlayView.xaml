<UserControl x:Class="HyIO.Views.ImageOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,16">
            <TextBox x:Name="SearchBox"
                     Width="260"
                     Height="32"
                     Padding="0,4"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource AppFontFamily}"
                     Foreground="{StaticResource AppTextPrimaryBrush}"
                     Background="{StaticResource AppSurfaceAltBrush}"
                     BorderBrush="{StaticResource AppBorderBrush}"
                     BorderThickness="1"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="파일명 또는 태그 검색"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{StaticResource AppTextSecondaryBrush}"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ImageScrollViewer"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ImageScrollViewer_ScrollChanged">
                <ItemsControl x:Name="ImageItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ImageButton_Click"
                                    Margin="4"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder"
                                                Background="Transparent"
                                                CornerRadius="14">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder"
                                                        Property="Background"
                                                        Value="#FFBEE6FD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CardBorder"
                                                        Property="Background"
                                                        Value="#FFD7EEFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border Width="160"
                                        Margin="4"
                                        Padding="8"
                                        CornerRadius="12"
                                        Background="{StaticResource AppSurfaceAltBrush}">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="144" Height="144"
                                               Stretch="UniformToFill"
                                               Margin="0,0,0,8"
                                               SnapsToDevicePixels="True"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ItemsControl ItemsSource="{Binding Tags}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EDE9FE"
                                                            CornerRadius="12"
                                                            Margin="0,0,4,4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11"
                                                                   FontFamily="{StaticResource AppFontFamily}"
                                                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="ImageCustomScrollTrack"
                    Grid.Column="1"
                    Width="20"
                    Margin="0"
                    Background="{StaticResource TagScrollBarTrackBackgroundBrush}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    SizeChanged="ImageCustomScrollTrack_SizeChanged">
                <Grid>
                    <Border x:Name="ImageCustomScrollThumb"
                            Background="{StaticResource TagScrollBarThumbBackgroundBrush}"
                            CornerRadius="8"
                            Margin="4"
                            VerticalAlignment="Top"
                            Height="40"
                            Cursor="Hand"
                            MouseLeftButtonDown="ImageCustomScrollThumb_MouseLeftButtonDown"
                            MouseLeftButtonUp="ImageCustomScrollThumb_MouseLeftButtonUp"
                            MouseMove="ImageCustomScrollThumb_MouseMove" />
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="LoadingOverlay"
                Grid.RowSpan="2"
                Background="#CCF5F6FA"
                CornerRadius="18"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Border Width="360"
                    Padding="28"
                    CornerRadius="24"
                    Background="White"
                    BorderBrush="#18000000"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Image Source="Resources/hyio_image.png"
                           Width="180"
                           Height="180"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                    <TextBlock Text="이미지 목록을 준비하고 있습니다"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontFamily}"/>
                    <TextBlock x:Name="LoadingStatusText"
                               Text="이미지 목록을 불러오는 중..."
                               HorizontalAlignment="Center"
                               Margin="0,12,0,16"
                               Foreground="{StaticResource AppTextSecondaryBrush}"
                               FontSize="13"
                               FontFamily="{StaticResource AppFontFamily}"/>
                    <ProgressBar x:Name="LoadingProgressBar"
                                 Height="14"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource ButtonOrangeMiddleBrush}"
                                 Background="#FFF1F3F7"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
